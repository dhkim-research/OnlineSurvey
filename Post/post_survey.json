{
  "surveyId": "main-survey",
  "title": "Main Survey",
  "version": "1.1.1",
  "intro": "Please answer the questions below based on your experience in the last session.",
  "pages": [
    {
      "id": "participant",
      "title": "Participant",
      "questions": [
        {
          "id": "participant_number",
          "type": "number",
          "prompt": "Participant Number",
          "required": true,
          "min": 1,
          "step": 1,
          "placeholder": "e.g., 12"
        }
      ]
    },
    {
      "id": "session",
      "title": "Session",
      "questions": [
        {
          "id": "session_number",
          "type": "number",
          "prompt": "Session Number",
          "required": true,
          "min": 1,
          "step": 1,
          "placeholder": "e.g., 3"
        }
      ]
    },
    {
      "id": "air_thermal_1",
      "title": "Air & Thermal",
      "questions": [
        {
          "id": "aq_satisfaction",
          "type": "likert",
          "prompt": "How satisfied were you with the air quality during the last session?",
          "required": true,
          "points": 7,
          "labels": [
            "Very dissatisfied",
            "Dissatisfied",
            "Slightly dissatisfied",
            "Neutral",
            "Slightly satisfied",
            "Satisfied",
            "Very satisfied"
          ],
          "values": [
            "Very dissatisfied",
            "Dissatisfied",
            "Slightly dissatisfied",
            "Neutral",
            "Slightly satisfied",
            "Satisfied",
            "Very satisfied"
          ]
        },
        {
          "id": "thermal_sensation",
          "type": "likert",
          "prompt": "During the last session, how did you feel thermally (overall)?",
          "required": true,
          "points": 7,
          "labels": [
            "Cold",
            "Cool",
            "Slightly cool",
            "Neutral",
            "Slightly warm",
            "Warm",
            "Hot"
          ],
          "values": [
            "Cold",
            "Cool",
            "Slightly cool",
            "Neutral",
            "Slightly warm",
            "Warm",
            "Hot"
          ]
        },
        {
          "id": "thermal_satisfaction",
          "type": "likert",
          "prompt": "How satisfied were you with the thermal environment during the last session?",
          "required": true,
          "points": 7,
          "labels": [
            "Very dissatisfied",
            "Dissatisfied",
            "Slightly dissatisfied",
            "Neutral",
            "Slightly satisfied",
            "Satisfied",
            "Very satisfied"
          ],
          "values": [
            "Very dissatisfied",
            "Dissatisfied",
            "Slightly dissatisfied",
            "Neutral",
            "Slightly satisfied",
            "Satisfied",
            "Very satisfied"
          ]
        }
      ]
    },
    {
      "id": "thermal_2",
      "title": "Thermal Preferences",
      "questions": [
        {
          "id": "prefer_temp_change",
          "type": "likert",
          "prompt": "During the last session, would you have preferred warmer or coller thermal conditions?",
          "required": true,
          "points": 3,
          "labels": ["Cooler", "Without change", "Warmer"],
          "values": ["Cooler", "Without change", "Warmer"]
        },
        {
          "id": "prefer_air_movement",
          "type": "likert",
          "prompt": "During the last session, would you have preferred more or less air movement?",
          "required": true,
          "points": 3,
          "labels": ["Less", "No change", "More"],
          "values": ["Less", "No change", "More"]
        },
        {
          "id": "thermal_pleasantness",
          "type": "likert",
          "prompt": "During the last session, how pleasant was the thermal environment?",
          "required": true,
          "points": 7,
          "labels": [
            "Very unpleasant",
            "Unpleasant",
            "Slightly unpleasant",
            "Indifferent",
            "Slightly pleasant",
            "Pleasant",
            "Very pleasant"
          ],
          "values": [
            "Very unpleasant",
            "Unpleasant",
            "Slightly unpleasant",
            "Indifferent",
            "Slightly pleasant",
            "Pleasant",
            "Very pleasant"
          ]
        },
        {
          "id": "thermal_acceptability",
          "type": "likert",
          "prompt": "During the last session, how acceptable was the thermal environment?",
          "required": true,
          "points": 5,
          "labels": [
            "Clearly unacceptable",
            "Just unacceptable",
            "Neutral",
            "Just acceptable",
            "Clearly acceptable"
          ],
          "values": [
            "Clearly unacceptable",
            "Just unacceptable",
            "Neutral",
            "Just acceptable",
            "Clearly acceptable"
          ]
        }
      ]
    },
    {
      "id": "lighting",
      "title": "Lighting",
      "questions": [
        {
          "id": "lighting_satisfaction",
          "type": "likert",
          "prompt": "During the last session, how satisfied with the lighting quality were you?",
          "required": true,
          "points": 7,
          "labels": [
            "Very dissatisfied",
            "Dissatisfied",
            "Slightly dissatisfied",
            "Neutral",
            "Slightly satisfied",
            "Satisfied",
            "Very satisfied"
          ],
          "values": [
            "Very dissatisfied",
            "Dissatisfied",
            "Slightly dissatisfied",
            "Neutral",
            "Slightly satisfied",
            "Satisfied",
            "Very satisfied"
          ]
        },
        {
          "id": "glare_experience",
          "type": "likert",
          "prompt": "Did you experience any discomfort from glare during the last session?",
          "required": true,
          "points": 2,
          "labels": ["Yes", "No"],
          "values": ["Yes", "No"]
        },
        {
          "id": "glare_level",
          "type": "likert",
          "prompt": "Please describe the level of glare during the last session",
          "required": true,
          "points": 4,
          "labels": ["Imperceptible", "Noticeable", "Disturbing", "Intolerable"],
          "values": ["Imperceptible", "Noticeable", "Disturbing", "Intolerable"],
          "showIf": { "questionId": "glare_experience", "equals": "Yes" }
        },
        {
          "id": "light_level_preference",
          "type": "likert",
          "prompt": "During the last session, would you have preferred more or less light on your desk?",
          "required": true,
          "points": 7,
          "labels": [
            "Much less",
            "Less",
            "Slightly less",
            "No change - the amount was adequate",
            "Slightly more",
            "More",
            "Much more"
          ],
          "values": [
            "Much less",
            "Less",
            "Slightly less",
            "No change - the amount was adequate",
            "Slightly more",
            "More",
            "Much more"
          ]
        },

        {
          "id": "aesthetic_interest",
          "type": "slider",
          "prompt": "From an aesthetic standpoint, how interesting were the facade and its accompanying sunlight patterns during the last session?",
          "required": true,
          "min": 0,
          "max": 100,
          "step": 1,
          "minLabel": "Not at all",
          "maxLabel": "Very much"
        },

        {
          "id": "daylight_well_lit",
          "type": "likert",
          "prompt": "During the last session, would you say the room received enough daylight?",
          "required": true,
          "points": 2,
          "labels": ["Yes", "No"],
          "values": ["Yes", "No"]
        }
      ]
    },
    {
      "id": "view",
      "title": "View",
      "questions": [
        {
          "id": "view_features_maintained",
          "type": "slider",
          "prompt": "How well did the facade system maintain the visibility of the view features you care about during the last session?",
          "required": true,
          "min": 0,
          "max": 100,
          "step": 1,
          "minLabel": "Not at all maintained",
          "maxLabel": "Very much maintained"
        },
        {
          "id": "view_amount_satisfaction",
          "type": "slider",
          "prompt": "How satisfied were you with the amount of the view during the last session?",
          "required": true,
          "min": 0,
          "max": 100,
          "step": 1,
          "minLabel": "Not at all",
          "maxLabel": "Very much satisfied"
        },
        {
          "id": "overall_view_satisfaction",
          "type": "slider",
          "prompt": "Overall, how satisfied were you with the view from the window during the last session?",
          "required": true,
          "min": 0,
          "max": 100,
          "step": 1,
          "minLabel": "Not at all",
          "maxLabel": "Very much satisfied"
        }
      ]
    },
    {
      "id": "overall",
      "title": "Overall",
      "questions": [
        {
          "id": "overall_comfort",
          "type": "likert",
          "prompt": "Overall, during the last session, how comfortable was the indoor environment?",
          "required": true,
          "points": 4,
          "labels": ["Very comfortable", "Comfortable", "Uncomfortable", "Very uncomfortable"],
          "values": ["Very comfortable", "Comfortable", "Uncomfortable", "Very uncomfortable"]
        },
        {
          "id": "comfort_reason",
          "type": "text",
          "prompt": "Is there any specific reason why you find the overall indoor environment comfortable?",
          "required": false,
          "multiline": true,
          "placeholder": "Optional"
        },
        {
          "id": "disturbed_anything",
          "type": "text",
          "prompt": "Is there anything about the physical environment that disturbed you?",
          "required": true,
          "multiline": true,
          "placeholder": "Answer 'No' if nothing disturbed you"
        },
        {
          "id": "desired_changes",
          "type": "text",
          "prompt": "Assuming that you have to work all day from this space and have full control over heating/cooling, the facade and the desk layout, would you change anything?",
          "required": false,
          "multiline": true,
          "placeholder": "Optional"
        }
      ]
    }
  ]
}